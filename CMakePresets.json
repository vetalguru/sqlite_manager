{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
    "configurePresets": [
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-asan",
            "displayName": "Linux ASan+UBSan",
            "inherits": "linux-debug",
            "binaryDir": "${sourceDir}/build/asan",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "linux-coverage",
            "displayName": "Linux Coverage",
            "inherits": "linux-debug",
            "binaryDir": "${sourceDir}/build/coverage",
            "cacheVariables": {
                "SQLITE_MANAGER_COVERAGE": "ON"
            }
        },
        {
            "name": "windows-wtl",
            "displayName": "Windows WTL GUI",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-wtl",
            "cacheVariables": {
                "SQLITE_MANAGER_BUILD_WTL_GUI": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        { "name": "linux-debug", "configurePreset": "linux-debug" },
        { "name": "linux-release", "configurePreset": "linux-release" },
        { "name": "linux-asan", "configurePreset": "linux-asan" },
        { "name": "linux-coverage", "configurePreset": "linux-coverage" },
        {
            "name": "windows-wtl",
            "configurePreset": "windows-wtl",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "linux-asan",
            "configurePreset": "linux-asan",
            "output": { "outputOnFailure": true },
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
                "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
            }
        },
        {
            "name": "linux-coverage",
            "configurePreset": "linux-coverage",
            "output": { "outputOnFailure": true }
        }
    ]
}
