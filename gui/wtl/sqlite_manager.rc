#include <windows.h>

#include "resource.h"

// The frame's menu. The frame loads it by IDR_MAINFRAME (see
// DECLARE_FRAME_WND_CLASS in main_frame.h).
IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open Database...",  ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "E&xit",              ID_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Add &Row",           ID_EDIT_ADD_ROW
        MENUITEM "&Delete Row",        ID_EDIT_DELETE_ROW
    END
    POPUP "&Transaction"
    BEGIN
        MENUITEM "&Begin",             ID_TXN_BEGIN
        MENUITEM "&Commit",            ID_TXN_COMMIT
        MENUITEM "&Rollback",          ID_TXN_ROLLBACK
    END
END

// Modal dialog to edit a single cell's value.
IDD_EDIT_CELL DIALOGEX 0, 0, 240, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit cell"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Value:",   IDC_STATIC,     8,  8,  60, 10
    EDITTEXT                    IDC_EDIT_VALUE, 8,  20, 224, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",       IDOK,           128, 46, 50, 14
    PUSHBUTTON      "Cancel",   IDCANCEL,       182, 46, 50, 14
END
