#include <windows.h>

#include "resource.h"

// The frame's menu. The frame loads it by IDR_MAINFRAME (see
// DECLARE_FRAME_WND_CLASS in main_frame.h).
IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open Database...",  ID_FILE_OPEN_DB
        MENUITEM "Export &Result...",  ID_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",              ID_FILE_EXIT
    END
    POPUP "&Query"
    BEGIN
        MENUITEM "&Run SQL...",        ID_QUERY_RUN
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Add &Row",           ID_EDIT_ADD_ROW
        MENUITEM "&Delete Row",        ID_EDIT_DELETE_ROW
        MENUITEM SEPARATOR
        MENUITEM "Add &Column...",     ID_EDIT_ADD_COLUMN
        MENUITEM "Drop Colu&mn...",    ID_EDIT_DROP_COLUMN
    END
    POPUP "&Transaction"
    BEGIN
        MENUITEM "&Begin",             ID_TXN_BEGIN
        MENUITEM "&Commit",            ID_TXN_COMMIT
        MENUITEM "&Rollback",          ID_TXN_ROLLBACK
    END
END

// Modal dialog to edit a single cell's value.
IDD_EDIT_CELL DIALOGEX 0, 0, 240, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit cell"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Value:",   IDC_STATIC,     8,  8,  60, 10
    EDITTEXT                    IDC_EDIT_VALUE, 8,  20, 224, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",       IDOK,           128, 46, 50, 14
    PUSHBUTTON      "Cancel",   IDCANCEL,       182, 46, 50, 14
END

// Modal dialog to add a column (name + optional declared type).
IDD_ADD_COLUMN DIALOGEX 0, 0, 220, 86
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add column"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name:",  IDC_STATIC,    8,  10, 40, 10
    EDITTEXT                  IDC_COL_NAME,  52, 8,  160, 14, ES_AUTOHSCROLL
    LTEXT           "Type:",  IDC_STATIC,    8,  30, 40, 10
    EDITTEXT                  IDC_COL_TYPE,  52, 28, 160, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",     IDOK,          108, 62, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL,      162, 62, 50, 14
END

// Modal dialog to drop a column (pick from the table's columns).
IDD_DROP_COLUMN DIALOGEX 0, 0, 220, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Drop column"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Column:", IDC_STATIC,   8,  12, 40, 10
    COMBOBOX                   IDC_COL_LIST,  52, 10, 160, 80,
                               CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",      IDOK,          108, 46, 50, 14
    PUSHBUTTON      "Cancel",  IDCANCEL,      162, 46, 50, 14
END

// Modal dialog to run an ad-hoc SQL statement.
IDD_RUN_SQL DIALOGEX 0, 0, 300, 160
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Run SQL"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT        IDC_SQL_TEXT, 8, 8, 284, 120,
                    ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL |
                    WS_TABSTOP
    DEFPUSHBUTTON   "Run",    IDOK,     188, 136, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 242, 136, 50, 14
END
